<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Framework v7.0 Section 60: user-grantable, requested via Settings deep
         link, never assumed. We deliberately do NOT declare USE_EXACT_ALARM -
         that permission is reserved by Play policy for calendar/alarm-clock
         category apps, which this is not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Needed only to rebuild scheduling after reboot (Section 15) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Requested at runtime only once the user enables calendar automation
         (Section 26) - declaring it here does not request it at install time
         on the API levels this app supports. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Required to read/apply DND / interruption-filter state (Section 26) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Runtime-requested on API 33+ only, and only for optional mode-change
         notifications (Section 26) - never required for scheduling itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Deliberately NOT declared - framework v7.0 Section 65:
         android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         setExactAndAllowWhileIdle() already fires during Doze without it,
         and Play policy restricts this prompt to core-functionality
         categories this app does not belong to. -->

    <uses-feature android:name="android.hardware.calendar" android:required="false" />

    <application
        android:name=".SmartSilentApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartSilentScheduler"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartSilentScheduler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Each receiver below owns exactly one trigger (framework Section 8),
             all funnelled through BaseReconciliationReceiver into the same
             reconcile() path (Section 7). UnlockReceiver is intentionally
             absent here - see its class doc - it is registered dynamically
             by SmartSilentApplication instead. -->

        <receiver android:name=".scheduling.AlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.smartsilent.scheduler.action.ALARM_FIRED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".lifecycle.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".lifecycle.TimeChangedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".lifecycle.TimezoneChangedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".lifecycle.PackageReplacedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".lifecycle.ExactAlarmPermissionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Framework Section 30 -->
        <service
            android:name=".tile.AutomationTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Framework Section 31 -->
        <receiver
            android:name=".widget.SmartSilentWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smartsilent_widget_info" />
        </receiver>

    </application>

</manifest>
